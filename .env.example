# Required for email notifications
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM=Bez Struje <obavestenja@tvoj-domen.rs>

# Set this to your Railway public URL
BASE_URL=https://bez-struje-production.up.railway.app

# Optional
# On Railway, mount a Volume (e.g. at /data) and point the DB inside it so it
# survives redeploys/restarts. Locally you can leave the default below.
DATABASE_PATH=/data/bez_struje.db
CHECK_INTERVAL=60
MAX_DAYS_AHEAD=7
LOG_LEVEL=INFO
